# F.R.I.D.A.Y. — copy to .env.
# Data store (Spec A): Postgres via psycopg. Use the Neon POOLED connection string.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# Local dev run only (Flask dev server); ignored on Vercel:
FRIDAY_HOST=127.0.0.1
FRIDAY_PORT=5000
# Your timezone. Serverless hosts run in UTC, so this must be set for correct times.
FRIDAY_TZ=America/New_York

# Phase 2 — DeepSeek. Without a key, chat shows a friendly notice.
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash

# Spec B — voice endpoint (POST /api/voice). Shared secret the ESP32 sends as a bearer token.
# Empty ⇒ the endpoint refuses every request (fail closed). Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
VOICE_TOKEN=

# Music — Spotify. Create an app at developer.spotify.com; add REDIRECT_URI to its
# allowed callbacks. On Vercel set REDIRECT_URI to the deployed callback URL.
# Tokens are obtained via /api/music/spotify/login and stored in the settings table.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REDIRECT_URI=http://localhost:5000/api/music/spotify/callback

# Messaging — Comms by Osis (https://docs.osis.co). Server-side key, scope comms_send.
# Empty ⇒ the send_sms tool returns a friendly "not configured" error.
# COMMS_OSIS_API=

# Web search — SerpAPI (https://serpapi.com). Google results via one key.
# Empty ⇒ the search_web tool returns a friendly "not configured" error.
# SERP_API_KEY=

# Day-before reminders (/api/cron/reminders, daily via vercel.json crons).
# Vercel sends this as `Authorization: Bearer <CRON_SECRET>`. Empty ⇒ endpoint 401s everything.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
# CRON_SECRET=

# Tests: a disposable Postgres (local Docker or a Neon branch).
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/friday_test

# Email — Gmail (Spec M). OAuth app at console.cloud.google.com, kept in Testing mode
# with your account as the only test user (no Google verification for one user; refresh
# tokens then expire every 7 days and you reconnect). Reading and drafting only —
# sending needs a click in the UI, and gmail.send is requested only when
# gmail_send_enabled is set to true in the settings table.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:5000/mail/callback
